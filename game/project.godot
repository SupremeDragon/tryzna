; Тризна — конфігурація проєкту.
; Godot 4.7

config_version=5

[application]

config/name="Тризна"
config/description="2D-RPG про три світи. Ракурс камери — це стан душі персонажа."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

EventBus="*res://autoload/event_bus.gd"
Projector="*res://core/space/projector.gd"
GameState="*res://autoload/game_state.gd"
Ledger="*res://autoload/ledger.gd"
SaveSystem="*res://autoload/save_system.gd"
WorldMode="*res://autoload/world_mode.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

