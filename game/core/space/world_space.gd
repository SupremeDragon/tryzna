class_name WorldSpace
extends RefCounted
## Константи логічного простору «Тризни».
##
## Живуть окремо від автолоада `Projector`, бо константи класу доступні на етапі
## розбору скрипта, а поля автолоада — лише під час виконання.

## Множник ГЛИБИНИ. Скільки розташування видно на екрані.
const DEPTH_VYS: float = 0.92   # майже прямовисно згори
const DEPTH_PLYN: float = 0.55  # три чверті — ти всередині життя
const DEPTH_NYTS: float = 0.0   # смерть забрала розташування

## Множник ВИСОТИ. Скільки зросту видно на екрані.
const HEIGHT_VYS: float = 0.0   # піднесення забрало зріст: світ став картою
const HEIGHT_PLYN: float = 1.0
const HEIGHT_NYTS: float = 1.0  # у Ниці зріст — єдине, що лишилося

## Розмір логічної клітинки землі, у пікселях. Потрібен сірому прототипу.
const CELL: float = 96.0
